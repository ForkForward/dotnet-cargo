<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../signing.props" />

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IsWindows)' == 'true' ">
    <TargetFrameworks>$(TargetFrameworks);net472</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>MassTransit</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Published as ForkForward.Cargo.AzureServiceBus. It continues the original package MassTransit.Azure.ServiceBus.Core; the assembly name and namespaces are unchanged. -->
    <IsPackable>true</IsPackable>
    <PackageId>ForkForward.Cargo.AzureServiceBus</PackageId>
    <Title>ForkForward.Cargo.AzureServiceBus</Title>
    <PackageTags>forkforward;cargo;masstransit;messaging;servicebus;azure;azureservicebus</PackageTags>
    <Description>Azure Service Bus transport for ForkForward Cargo; $(Description)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <ProjectReference Include="..\..\MassTransit\MassTransit.csproj" />
  </ItemGroup>

</Project>
