<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../signing.props" />

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>MassTransit</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Published as ForkForward.Cargo.EntityFrameworkCore. It continues the original package MassTransit.EntityFrameworkCore; the assembly name and namespaces are unchanged. -->
    <IsPackable>true</IsPackable>
    <PackageId>ForkForward.Cargo.EntityFrameworkCore</PackageId>
    <Title>ForkForward.Cargo.EntityFrameworkCore</Title>
    <PackageTags>forkforward;cargo;masstransit;messaging;efcore;entityframeworkcore</PackageTags>
    <Description>Entity Framework Core persistence for ForkForward Cargo; $(Description)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MassTransit\MassTransit.csproj" />
  </ItemGroup>
</Project>
