<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props"/>

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IsWindows)' == 'true' ">
    <TargetFrameworks>$(TargetFrameworks);net472</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>MassTransit</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Published as ForkForward.Cargo.Abstractions. It continues the original package MassTransit.Abstractions; the assembly name and namespaces are unchanged. -->
    <IsPackable>true</IsPackable>
    <PackageId>ForkForward.Cargo.Abstractions</PackageId>
    <Title>ForkForward.Cargo.Abstractions</Title>
    <PackageTags>forkforward;cargo;masstransit;messaging;servicebus</PackageTags>
    <Description>Abstractions for ForkForward Cargo; $(Description)</Description>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <PackageReference Include="System.ValueTuple"/>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Futures\Futures"/>
  </ItemGroup>
</Project>
